{
  "autoMemoryEnabled": false,
  "sandbox": {
    "enableWeakerNestedSandbox": true,
    "failIfUnavailable": false
  },
  "statusLine": {
    "type": "command",
    "command": "bash /vibe/payload/container/statusline.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash /vibe/payload/container/subagent-statusline.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /vibe/payload/container/agent-state-hook.sh SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /vibe/payload/container/agent-state-hook.sh UserPromptSubmit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /vibe/payload/container/agent-state-hook.sh PostToolUse"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /vibe/payload/container/agent-state-hook.sh Notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /vibe/payload/container/agent-state-hook.sh Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /vibe/payload/container/agent-state-hook.sh SessionEnd"
          }
        ]
      }
    ]
  }
}
